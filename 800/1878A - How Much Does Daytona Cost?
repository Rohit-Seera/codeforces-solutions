#include <bits/stdc++.h>
using namespace std;
 
void solve(){
    int n , k;
    cin >> n >>k;
    vector <long long> v(n);
    for(int i=0; i<n; i++){
        cin >> v[i];
    }
    int is_present = 0;
    for(int i = 0; i<n; i++){
        if(v[i] == k){
           is_present = 1;
        }
    }
    if(is_present == 1){
        cout<<"YES"<<endl;
    }
    else{
        cout << "NO"<<endl;
    }
}
 
int main() {
int t; cin>>t;
while(t--){
    solve();
}
}
