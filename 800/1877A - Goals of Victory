#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n ;
    cin >> n ;
    vector <long long> v(n);
    for(int i=0; i<n-1; i++){
        cin >> v[i];
    }
    int sum=0;
    for(int i =0;i<n-1;i++){
        sum+=v[i];
    }
    cout << -sum <<endl;
}

int main() {
int t; cin>>t;
while(t--){
    solve();
}
}
